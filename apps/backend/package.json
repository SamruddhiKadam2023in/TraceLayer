{
  "name": "@tracelayer/backend",
  "version": "0.1.0",
  "private": true,
  "description": "TraceLayer REST API and Socket.IO server",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@tracelayer/db": "workspace:^",
    "@tracelayer/shared": "workspace:^",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17",
    "express": "^5",
    "helmet": "^8",
    "ioredis": "^5",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/supertest": "^7.2.1",
    "jest": "^30",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29",
    "tsx": "^4.23.15"
  }
