{
  "name": "@tracelayer/worker",
  "version": "0.1.0",
  "private": true,
  "description": "TraceLayer background worker: executes scheduled monitor checks from BullMQ",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@tracelayer/db": "workspace:^",
    "@tracelayer/executor": "workspace:^",
    "@tracelayer/shared": "workspace:^",
    "bullmq": "^5",
    "dotenv": "^17",
    "ioredis": "^5",
    "pino": "^9",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^20",
    "jest": "^30",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29",
    "tsx": "^4.23.15"
  }
}
