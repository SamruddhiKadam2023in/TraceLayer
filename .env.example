# ─────────────────────────────────────────────────────────────
# TraceLayer environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# Values below are for LOCAL DEVELOPMENT ONLY.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Database (host-side dev; docker compose overrides the host to `postgres`)
POSTGRES_USER=tracelayer
POSTGRES_PASSWORD=tracelayer
POSTGRES_DB=tracelayer
POSTGRES_PORT=5434
DATABASE_URL=postgresql://tracelayer:tracelayer@localhost:5434/tracelayer?schema=public

# ── Redis (docker compose overrides the host to `redis`)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Redis key prefix for BullMQ queues; the API and worker must use the same value.
QUEUE_PREFIX=tracelayer

# ── HTTP
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:4000

# ── Auth — generate strong values, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# bcrypt cost factor (4–15). 12 is a good production default.
BCRYPT_ROUNDS=12
# Secure flag on the auth cookie. Defaults to true when NODE_ENV=production.
# Must be false when the app is served over plain http (e.g. the local Docker stack).
# COOKIE_SECURE=true

# ── Request execution
# SSRF protection blocks requests to private, loopback, link-local and cloud-metadata
# addresses. Set to true ONLY for local development against APIs on your own machine.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# ── Encryption key for secret environment variables (32 bytes, base64)
# Secrets stored in the database are encrypted with this key. Changing it makes every
# existing secret unreadable: keep it stable and back it up like a password.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# ── Production safety
# With NODE_ENV=production, the API and worker refuse to start while any secret above is still
# a development placeholder. The local Docker stack sets this to true (see docker-compose.yml);
# never set it in a real deployment.
# ALLOW_DEV_SECRETS=false

# ── Email (SMTP) for alert notifications, sent by the worker.
# Leave SMTP_HOST empty to log emails instead of sending. The Docker stack defaults to the
# bundled Mailpit (SMTP_HOST=mailpit, SMTP_PORT=1025; inbox at http://localhost:8025).
# Port 465 uses implicit TLS; other ports upgrade with STARTTLS when the server offers it.
SMTP_HOST=
# SMTP_PORT=587        # default 587; the Docker stack uses 1025 (Mailpit) unless set
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TraceLayer <alerts@tracelayer.local>"
# Base URL of the web app, used for links in alert emails.
APP_URL=http://localhost:8080
