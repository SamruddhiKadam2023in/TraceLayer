// TraceLayer database schema.
// Models are introduced phase by phase; each phase adds a migration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication (Phase 2) ────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  /// Always stored lowercased; the unique constraint doubles as the lookup index.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  memberships       WorkspaceMember[]
  createdProjects   Project[]
  createdEndpoints  Endpoint[]
  requestHistory    RequestHistory[]
  createdMonitors   Monitor[]
  assignedIncidents Incident[]        @relation("IncidentAssignee")
  resolvedIncidents Incident[]        @relation("IncidentResolver")
  incidentEvents    IncidentEvent[]

  @@map("users")
}

/// One row per issued refresh token. Rotation revokes the old row and inserts a new one in
/// the same family; presenting a revoked token revokes the whole family (theft detection).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// HMAC-SHA256 of the raw token. The raw token only ever exists in the client's cookie.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Shared by every token descended from the same login.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Workspaces (Phase 3) ────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("workspace_role")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members              WorkspaceMember[]
  projects             Project[]
  notificationChannels NotificationChannel[]
  notifications        Notification[]

  @@map("workspaces")
}

/// A user's role in a workspace. Every workspace keeps at least one OWNER.
model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Also serves lookups by workspace (leading column): members of a workspace, access checks.
  @@unique([workspaceId, userId])
  /// "Which workspaces does this user belong to?"
  @@index([userId])
  @@map("workspace_members")
}

// ─── Projects & environments (Phase 4) ───────────────────────────────────────

model Project {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  /// Unique per workspace, compared case-insensitively by the service.
  name              String   @db.VarChar(100)
  description       String?  @db.VarChar(500)
  /// Last incident number used; incidents are numbered #1, #2, … per project.
  incidentCounter   Int      @default(0) @map("incident_counter")
  /// Bumped by every dependency-map save; saves must name the version they started from.
  dependencyVersion Int      @default(0) @map("dependency_version")
  /// Kept as null if the creator's account is deleted.
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  environments    Environment[]
  endpoints       Endpoint[]
  requests        RequestHistory[]
  monitors        Monitor[]
  monitorRuns     MonitorRun[]
  alertRules      AlertRule[]
  alerts          Alert[]
  incidents       Incident[]
  dependencyNodes DependencyNode[]
  dependencyEdges DependencyEdge[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("projects")
}

model Environment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(50)
  /// Prefix for endpoint paths, e.g. https://api.example.com. Optional until endpoints use it.
  baseUrl   String?  @map("base_url") @db.VarChar(2048)
  /// Display order within the project (0-based). Rows inserted together share a timestamp,
  /// so creation time cannot order them.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables EnvironmentVariable[]
  endpoints Endpoint[]
  requests  RequestHistory[]
  monitors  Monitor[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environments")
}

/// Exactly one of `value` (plain variables) and `encryptedValue` (secrets) is set.
/// Secrets are AES-256-GCM encrypted with ENCRYPTION_KEY and never returned by the API.
model EnvironmentVariable {
  id             String   @id @default(uuid()) @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  key            String   @db.VarChar(100)
  isSecret       Boolean  @default(false) @map("is_secret")
  value          String?
  encryptedValue String?  @map("encrypted_value")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@map("environment_variables")
}

// ─── Endpoints (Phase 5) ─────────────────────────────────────────────────────

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS

  @@map("http_method")
}

/// A saved API request. Structured parts (headers, params, body, auth) are JSON validated by the
/// shared Zod schemas on every write and read. Values may reference environment variables as
/// {{NAME}}; credentials must (see endpointAuthSchema), so no secret is ever stored here.
model Endpoint {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  /// Default environment to run against. Cleared if that environment is deleted.
  environmentId  String?    @map("environment_id") @db.Uuid
  name           String     @db.VarChar(100)
  description    String?    @db.VarChar(500)
  method         HttpMethod
  url            String     @db.VarChar(2048)
  headers        Json       @default("[]")
  queryParams    Json       @default("[]") @map("query_params")
  body           Json       @default("{\"type\":\"none\"}")
  auth           Json       @default("{\"type\":\"none\"}")
  timeoutMs      Int        @default(10000) @map("timeout_ms")
  /// Status code counted as success; null means any 2xx.
  expectedStatus Int?       @map("expected_status")
  tags           String[]   @default([]) @db.VarChar(30)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment?     @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  requests    RequestHistory[]
  monitors    Monitor[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([environmentId])
  @@map("endpoints")
}

// ─── Request history (Phase 6) ───────────────────────────────────────────────

/// One manually executed request. Stores what was sent and how it went, never bodies or
/// secrets: the URL is recorded with secret values masked.
model RequestHistory {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  endpointId    String?    @map("endpoint_id") @db.Uuid
  environmentId String?    @map("environment_id") @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  method        HttpMethod
  url           String     @db.VarChar(4096)
  /// Null when no response arrived (see errorCode).
  status        Int?
  errorCode     String?    @map("error_code") @db.VarChar(40)
  errorMessage  String?    @map("error_message") @db.VarChar(500)
  durationMs    Int        @map("duration_ms")
  sizeBytes     Int?       @map("size_bytes")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint    Endpoint?    @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The history page: newest first within a project.
  @@index([projectId, createdAt(sort: Desc)])
  @@index([endpointId, createdAt(sort: Desc)])
  @@map("request_history")
}

// ─── Monitors (Phase 7) ──────────────────────────────────────────────────────

enum MonitorType {
  AVAILABILITY
  STATUS
  PERFORMANCE
  RESPONSE_VALIDATION

  @@map("monitor_type")
}

/// A scheduled check of one endpoint in one environment. Scheduling itself lives in BullMQ
/// (job scheduler "monitor:<id>"); this row is the source of truth the worker reconciles to.
model Monitor {
  id                  String      @id @default(uuid()) @db.Uuid
  projectId           String      @map("project_id") @db.Uuid
  endpointId          String      @map("endpoint_id") @db.Uuid
  /// Cleared if the environment is deleted; runs then fail with CONFIG_ERROR until fixed.
  environmentId       String?     @map("environment_id") @db.Uuid
  name                String      @db.VarChar(100)
  type                MonitorType
  intervalSeconds     Int         @map("interval_seconds")
  timeoutMs           Int         @map("timeout_ms")
  expectedStatus      Int?        @map("expected_status")
  latencyThresholdMs  Int?        @map("latency_threshold_ms")
  assertions          Json        @default("[]")
  enabled             Boolean     @default(true)
  /// Denormalised from the latest run, for fast lists.
  lastRunAt           DateTime?   @map("last_run_at") @db.Timestamptz(3)
  lastRunSuccess      Boolean?    @map("last_run_success")
  consecutiveFailures Int         @default(0) @map("consecutive_failures")
  createdById         String?     @map("created_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint    Endpoint     @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs        MonitorRun[]
  alertRules  AlertRule[]
  alerts      Alert[]
  incidents   Incident[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([endpointId])
  @@index([enabled])
  @@map("monitors")
}

/// One execution of a monitor: the raw data behind every metric (Phase 8).
model MonitorRun {
  id             String   @id @default(uuid()) @db.Uuid
  monitorId      String   @map("monitor_id") @db.Uuid
  /// Copied from the monitor at run time so metrics can group runs without joins.
  projectId      String   @map("project_id") @db.Uuid
  endpointId     String   @map("endpoint_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  success        Boolean
  statusCode     Int?     @map("status_code")
  durationMs     Int?     @map("duration_ms")
  sizeBytes      Int?     @map("size_bytes")
  timedOut       Boolean  @default(false) @map("timed_out")
  failureReason  String?  @map("failure_reason") @db.VarChar(40)
  failureMessage String?  @map("failure_message") @db.VarChar(500)

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Time-series access: a monitor's runs in a time window, newest first.
  @@index([monitorId, startedAt(sort: Desc)])
  /// Project-wide dashboards and retention pruning by time.
  @@index([projectId, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("monitor_runs")
}

// ─── Alerts & notifications (Phase 10) ───────────────────────────────────────

enum AlertMetric {
  LATENCY_P95
  ERROR_RATE
  UPTIME
  STATUS_CODE
  RESPONSE_TIME
  CONSECUTIVE_FAILURES

  @@map("alert_metric")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("severity")
}

enum AlertRuleState {
  OK
  PENDING
  FIRING

  @@map("alert_rule_state")
}

/// A threshold on one monitor. Evaluated by the worker after every run of that monitor; its
/// state (OK → PENDING → FIRING) is stored here so evaluation survives worker restarts.
model AlertRule {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  monitorId       String         @map("monitor_id") @db.Uuid
  name            String         @db.VarChar(100)
  metric          AlertMetric
  threshold       Float
  /// Window for aggregate metrics, hold time for per-check metrics (see ALERT_METRIC_INFO).
  durationMinutes Int            @map("duration_minutes")
  severity        Severity
  enabled         Boolean        @default(true)
  state           AlertRuleState @default(OK)
  pendingSince    DateTime?      @map("pending_since") @db.Timestamptz(3)
  lastValue       Float?         @map("last_value")
  lastEvaluatedAt DateTime?      @map("last_evaluated_at") @db.Timestamptz(3)
  createdById     String?        @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitor  Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channels AlertRuleChannel[]
  alerts   Alert[]

  @@index([monitorId])
  @@index([projectId])
  @@map("alert_rules")
}

enum AlertStatus {
  FIRING
  RESOLVED

  @@map("alert_status")
}

/// One firing of a rule, from breach to recovery. Incidents (Phase 11) are opened from these.
model Alert {
  id         String      @id @default(uuid()) @db.Uuid
  /// Kept (as null) if the rule is deleted, so the history survives.
  ruleId     String?     @map("rule_id") @db.Uuid
  monitorId  String      @map("monitor_id") @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  severity   Severity
  status     AlertStatus @default(FIRING)
  value      Float?
  threshold  Float
  message    String      @db.VarChar(500)
  firedAt    DateTime    @default(now()) @map("fired_at") @db.Timestamptz(3)
  resolvedAt DateTime?   @map("resolved_at") @db.Timestamptz(3)
  /// The incident this alert opened or joined.
  incidentId String?     @map("incident_id") @db.Uuid

  incident      Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  rule          AlertRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([projectId, firedAt(sort: Desc)])
  @@index([ruleId, status])
  @@index([incidentId])
  @@map("alerts")
}

enum ChannelType {
  EMAIL

  @@map("channel_type")
}

/// Where notifications go. Email only for now; `type` + `config` leave room for Slack,
/// Discord, PagerDuty or webhooks without schema changes to rules or alerts.
model NotificationChannel {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String      @db.VarChar(100)
  type        ChannelType
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules         AlertRuleChannel[]
  notifications Notification[]

  @@index([workspaceId])
  @@map("notification_channels")
}

model AlertRuleChannel {
  ruleId    String @map("rule_id") @db.Uuid
  channelId String @map("channel_id") @db.Uuid

  rule    AlertRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@index([channelId])
  @@map("alert_rule_channels")
}

enum NotificationEvent {
  ALERT_FIRED
  ALERT_RESOLVED
  TEST

  @@map("notification_event")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

/// Delivery log: one row per message per channel, updated by the worker as it is sent.
model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  channelId   String             @map("channel_id") @db.Uuid
  alertId     String?            @map("alert_id") @db.Uuid
  event       NotificationEvent
  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  error       String?            @db.VarChar(500)
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  alert     Alert?              @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)])
  @@index([alertId])
  @@map("notifications")
}

// ─── Incidents (spec §26–27) ─────────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  IDENTIFIED
  RESOLVED

  @@map("incident_status")
}

enum IncidentEventType {
  DETECTED
  ALERT_FIRED
  ALERT_RESOLVED
  STATUS_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  COMMENT

  @@map("incident_event_type")
}

/// Opened by the worker when an alert fires; later alerts of the same monitor join it while it
/// is open. Resolves automatically when its last firing alert resolves.
model Incident {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  number         Int
  /// Kept (as null) if the monitor is deleted, so the history survives.
  monitorId      String?        @map("monitor_id") @db.Uuid
  title          String         @db.VarChar(300)
  severity       Severity
  status         IncidentStatus @default(OPEN)
  assigneeId     String?        @map("assignee_id") @db.Uuid
  detectedAt     DateTime       @default(now()) @map("detected_at") @db.Timestamptz(3)
  acknowledgedAt DateTime?      @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(3)
  /// null with resolvedAt set means it resolved automatically.
  resolvedById   String?        @map("resolved_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitor    Monitor?        @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  assignee   User?           @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy User?           @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  alerts     Alert[]
  events     IncidentEvent[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, detectedAt(sort: Desc)])
  @@index([monitorId, status])
  @@index([assigneeId])
  @@map("incidents")
}

/// The incident timeline: system events and people's actions, in order.
model IncidentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  incidentId String            @map("incident_id") @db.Uuid
  type       IncidentEventType
  /// null for events recorded by TraceLayer itself.
  actorId    String?           @map("actor_id") @db.Uuid
  message    String?           @db.VarChar(2000)
  fromValue  String?           @map("from_value") @db.VarChar(100)
  toValue    String?           @map("to_value") @db.VarChar(100)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

// ─── Dependency map (spec §30) ───────────────────────────────────────────────

enum DependencyNodeKind {
  FRONTEND
  GATEWAY
  SERVICE
  DATABASE
  CACHE
  QUEUE
  EXTERNAL

  @@map("dependency_node_kind")
}

enum DependencyOrigin {
  MANUAL
  INFERRED

  @@map("dependency_origin")
}

/// A box on a project's dependency map. Ids are chosen by the editor, so connections can
/// reference new nodes before the first save.
model DependencyNode {
  id        String             @id @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  label     String             @db.VarChar(60)
  kind      DependencyNodeKind
  origin    DependencyOrigin
  /// Monitors calling this host give the node its health.
  host      String?            @db.VarChar(253)
  x         Int
  y         Int

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoing DependencyEdge[] @relation("DependencySource")
  incoming DependencyEdge[] @relation("DependencyTarget")

  @@index([projectId])
  @@map("dependency_nodes")
}

/// "source" depends on "target" (arrows point from caller to callee).
model DependencyEdge {
  id        String           @id @db.Uuid
  projectId String           @map("project_id") @db.Uuid
  sourceId  String           @map("source_id") @db.Uuid
  targetId  String           @map("target_id") @db.Uuid
  origin    DependencyOrigin
  label     String?          @db.VarChar(60)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  DependencyNode @relation("DependencySource", fields: [sourceId], references: [id], onDelete: Cascade)
  target  DependencyNode @relation("DependencyTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([projectId])
  @@map("dependency_edges")
}
