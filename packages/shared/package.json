{
  "name": "@tracelayer/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Isomorphic constants, types and Zod schemas shared by frontend, backend and worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "jest"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "jest": "^30",
    "ts-jest": "^29"
  }
}
